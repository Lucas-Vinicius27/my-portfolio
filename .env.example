# Variáveis de ambiente da função do formulário de contato (api/contact.js).
# Este arquivo só lista os nomes. Os valores reais ficam na Vercel
# (Settings > Environment Variables). Nunca coloque valores reais aqui.

# Chave secreta do widget do Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Chave de API do Resend (permissão "Sending access")
RESEND_API_KEY=

# E-mail que recebe as mensagens do formulário
CONTACT_TO_EMAIL=

# Remetente: e-mail de um domínio verificado no Resend ou onboarding@resend.dev
CONTACT_FROM_EMAIL=